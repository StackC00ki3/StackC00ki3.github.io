        <content type="html"><![CDATA[<div class="story post-story"><h2 id="where-is-my-rop"><a href="#where-is-my-rop" class="headerlink" title="where is my rop"></a>where is my rop</h2><h3 id="利用思路"><a href="#利用思路" class="headerlink" title="利用思路"></a>利用思路</h3><p><img src="/2025/04/07/TPCTF2025/sendLoginRequest.png" class="lazyload" data-srcset="/2025/04/07/TPCTF2025/sendLoginRequest.png" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAP///////yH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="sendlogin"></p></div>]]></content>
      
      
      
